# Copy to "cf.env" in this folder and fill in — used by ./deploy.sh only
# (plain "npx wrangler deploy" never reads this file). NEVER commit cf.env.
#
# API token: https://dash.cloudflare.com/profile/api-tokens
#   template "Edit Cloudflare Workers" (Zone/Workers read-write) is enough.
CF_API_TOKEN=your-clo…oken
CF_ACCOUNT_ID=your-cloudflare-account-id
