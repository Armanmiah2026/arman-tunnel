# Copy to android/local.properties (gitignored, regenerated by tooling) and
# point at YOUR machine's paths. On Windows use doubled backslashes or forward
# slashes. flutter.versionName/Code must stay in sync with lib/app_meta.dart.
sdk.dir=C\:\\Android\\android-sdk
flutter.sdk=C\:\\flutter
flutter.buildMode=debug
flutter.versionName=1.0.55
flutter.versionCode=61

# ---- Release signing (optional — see README section 4) ----
# Either put them here as sensei.* properties, or export the equivalent env
# vars SENSEI_STORE_FILE / SENSEI_STORE_PASSWORD / SENSEI_KEY_ALIAS /
# SENSEI_KEY_PASSWORD / SENSEI_EXPECTED_CERT_SHA256 (env wins). Debug builds
# work with NONE of these set.
#sensei.storeFile=upload-keystore.jks
#sensei.storePassword=your-keystore-password
#sensei.keyAlias=your-key-alias
#sensei.keyPassword=your-key-password
# Expected SHA-256 of the signing cert; hard-wired into libsenseicrypto.so.
# Leave empty for local builds; set it to match the app store certificate.
#sensei.expectedCertSha256=
